# =============================================================================
# Stellora — root environment (Docker / hosting overrides)
#
# This file configures the DOCKER STACK (docker-compose.yml).
# For bare-metal/PM2 deploys, backend config lives in backend/.env instead.
#
# Copy to .env and edit:
#   cp .env.example .env
# =============================================================================

# --- Database (REQUIRED) -----------------------------------------------------
# MongoDB Atlas (recommended, zero maintenance):
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stellora?retryWrites=true&w=majority"
# Self-hosted via the bundled mongo container: leave the default
#   mongodb://mongo:27017/stellora
# and run:  docker compose up -d
# (skip the bundled container with:  docker compose up -d --scale mongo=0)

# --- Public URLs -------------------------------------------------------------
# The single public origin users visit (storefront, which proxies everything):
APP_URL="http://localhost:3000"
# Dot-suffix allowlist for preview/staging hosts passing the CSRF origin check:
ORIGIN_SUFFIXES=".space-z.ai,.z.ai"

# --- First-boot admin & demo customer (seed) ---------------------------------
ADMIN_BOOTSTRAP_EMAIL="admin@stellora.local"
ADMIN_BOOTSTRAP_PASSWORD="StelloraAdmin#2026"
DEMO_CUSTOMER_EMAIL="customer@stellora.local"
DEMO_CUSTOMER_PASSWORD="Customer#2026"

# --- Payments ----------------------------------------------------------------
# Built-in DEMO gateway works out of the box (simulated Card/UPI checkout).
# For Razorpay: PAYMENTS_ENABLED="true", PAYMENT_PROVIDER="razorpay" + keys in
# Admin → Settings → Payment gateway (DB keys take precedence over env).
PAYMENTS_ENABLED="false"
PAYMENT_DEMO_SECRET="stellora_demo_secret_2026"

# --- Internal service URLs (Docker network) ----------------------------------
# Defaults are correct for docker compose; change only if you rename services.
# BACKEND_URL=http://api:4000
# ADMIN_URL=http://admin:3001
