# Stellora environment — copy to .env and fill values. NEVER commit real .env
# MySQL connection (development uses user-space MariaDB via scripts/setup-mariadb.sh)
DATABASE_URL="mysql://stellora:stellora_dev_pw@127.0.0.1:33061/stellora"

# Public app URL
APP_URL="http://localhost:3000"

# First admin account created by the seed script — change immediately after first login
ADMIN_BOOTSTRAP_EMAIL="admin@stellora.local"
ADMIN_BOOTSTRAP_PASSWORD="StelloraAdmin#2026"

# Demo customer account created by the seed script (development only)
DEMO_CUSTOMER_EMAIL="customer@stellora.local"
DEMO_CUSTOMER_PASSWORD="Customer#2026"

# Payments — keep false until a real payment provider is configured.
# When false, checkout uses the truthful "Pay on confirmation" flow.
PAYMENTS_ENABLED="false"
PAYMENT_PROVIDER=""
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Uploads
UPLOAD_MAX_MB="5"
