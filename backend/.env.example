# Stellora backend — copy to .env and fill values. NEVER commit real .env
# ---------- MySQL ----------
# DATABASE_URL is REQUIRED for prisma CLI commands (generate / migrate).
# Either set it directly:
#   DATABASE_URL="mysql://Stellora:PASSWORD@127.0.0.1:3306/Stellora"
# or the individual parts (DATABASE_URL wins when both are set):
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="Stellora"
DB_USER="Stellora"
DB_PASSWORD="REPLACE_WITH_REAL_PASSWORD"

PORT=4000
APP_URL="http://localhost:3000"
# Dot-suffix allowlist for dynamic preview/staging hosts (comma-separated).
# Browser Origins ending with one of these pass the same-origin (CSRF) check.
ORIGIN_SUFFIXES=".space-z.ai,.z.ai,.onrender.com"

ADMIN_BOOTSTRAP_EMAIL="admin@stellora.local"
ADMIN_BOOTSTRAP_PASSWORD="change-me"
DEMO_CUSTOMER_EMAIL="customer@stellora.local"
DEMO_CUSTOMER_PASSWORD="change-me"

# Payments — built-in DEMO gateway is active by default (fully working simulated
# card checkout with HMAC signature verification). To go live with Razorpay:
#   PAYMENTS_ENABLED="true", PAYMENT_PROVIDER="razorpay", set real API keys.
PAYMENTS_ENABLED="false"
PAYMENT_PROVIDER=""
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_DEMO_SECRET="stellora_demo_secret_2026"

UPLOAD_MAX_MB="5"
