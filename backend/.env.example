# Stellora backend — copy to .env and fill values. NEVER commit real .env
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stellora"
PORT=4000
APP_URL="http://localhost:3000"

ADMIN_BOOTSTRAP_EMAIL="admin@stellora.local"
ADMIN_BOOTSTRAP_PASSWORD="change-me"
DEMO_CUSTOMER_EMAIL="customer@stellora.local"
DEMO_CUSTOMER_PASSWORD="change-me"

PAYMENTS_ENABLED="false"
PAYMENT_PROVIDER=""
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

UPLOAD_MAX_MB="5"
