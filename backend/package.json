{
  "name": "@stellora/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "dev:bun": "bun --hot src/server.ts",
    "start:bun": "bun src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:dist": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx src/seed.ts",
    "db:seed:bun": "bun src/seed.ts"
  },
  "dependencies": {
    "@types/multer": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.16.0",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.19.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
