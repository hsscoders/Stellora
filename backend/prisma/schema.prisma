// ============================================================
// Stellora — MySQL schema (Prisma)
// Migration: MongoDB (Mongoose) → MySQL
//
// Design notes:
//  - IDs are CHAR(24) hex strings (Mongo ObjectIds preserved verbatim
//    during data migration; new rows generate the same 24-hex format),
//    so API responses keep their exact shape and ID-format logic in the
//    app (isValidObjectId checks etc.) keeps working.
//  - Money columns are DECIMAL(12,2) in MySQL (exact cents at rest).
//    The Prisma scalar is Decimal; lib/http.ts normalizes Decimal to
//    JSON numbers at the response boundary so API payloads stay
//    byte-compatible with the previous Mongo behaviour (numbers).
//  - relationMode = "prisma": MongoDB had no foreign-key constraints
//    and allowed orphaned references; enabling physical FKs would
//    change deletion semantics and break the data import. Referential
//    integrity is enforced at the application layer exactly as before,
//    with indexes on every reference column.
//  - Embedded Mongo documents (variants, images, order items, cart
//    items, addresses, wishlist, redemptions, events, subdocs) are
//    normalized into child tables keyed by a parent Char(24) column.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

/* ============================ Users & auth ============================ */

model User {
  id            String   @id @db.Char(24)
  email         String?  @unique @db.VarChar(191) // sparse-unique in Mongo == NULLs allowed here
  passwordHash  String   @db.VarChar(191)
  name          String   @db.VarChar(191)
  phone         String?  @db.VarChar(32)
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  addresses      Address[]
  wishlistItems  WishlistItem[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  orders         Order[]
  reviews        Review[]
  questions      ProductQuestion[]
  loyaltyEntries LoyaltyLedger[]
  returnRequests ReturnRequest[]

  @@index([phone])
  @@map("users")
}

model Address {
  id        String   @id @db.Char(24)
  userId    String   @db.Char(24)
  fullName  String   @db.VarChar(191)
  phone     String   @db.VarChar(32)
  line1     String   @db.VarChar(191)
  line2     String?  @db.VarChar(191)
  city      String   @db.VarChar(191)
  state     String   @db.VarChar(191)
  pincode   String   @db.VarChar(16)
  country   String   @default("India") @db.VarChar(191)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("useraddresses")
}

model WishlistItem {
  id        String   @id @db.Char(24)
  userId    String   @db.Char(24)
  productId String   @db.Char(24)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId, productId])
  @@map("wishlistitems")
}

model Session {
  id        String   @id @db.Char(24)
  tokenHash String   @unique @db.VarChar(64)
  userId    String   @db.Char(24)
  expiresAt DateTime
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @db.Char(24)
  tokenHash String    @unique @db.VarChar(64)
  userId    String    @db.Char(24)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("passwordresettokens")
}

/* ============================== Catalog ============================== */

model Category {
  id          String   @id @db.Char(24)
  slug        String   @unique @db.VarChar(191)
  name        String   @db.VarChar(191)
  description String?  @db.Text
  imageUrl    String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id               String        @id @db.Char(24)
  slug             String        @unique @db.VarChar(191)
  categoryId       String        @db.Char(24)
  name             String        @db.VarChar(191)
  shortDescription String        @db.Text
  description      String?       @db.Text
  materials        String?       @db.Text
  careInstructions String?       @db.Text
  status           ProductStatus @default(ACTIVE)
  isFeatured       Boolean       @default(false)
  isNewArrival     Boolean       @default(false)
  isBestSeller     Boolean       @default(false)
  isTrending       Boolean       @default(false)
  videoUrl         String?       @db.VarChar(500)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]
  question ProductQuestion[]
  wishlistItems WishlistItem[]

  @@index([categoryId, status])
  @@index([status, createdAt])
  @@map("products")
}

model ProductVariant {
  id                String   @id @db.Char(24)
  productId         String   @db.Char(24)
  sku               String   @db.VarChar(191)
  barcode           String?  @db.VarChar(64)
  name              String   @db.VarChar(191)
  price             Decimal  @db.Decimal(12, 2)
  compareAtPrice    Decimal? @db.Decimal(12, 2)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([barcode])
  @@index([sku])
  @@map("productvariants")
}

model ProductImage {
  id        String   @id @db.Char(24)
  productId String   @db.Char(24)
  url       String   @db.VarChar(500)
  alt       String?  @db.VarChar(191)
  sortOrder Int      @default(0)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("productimages")
}

model StockMovement {
  id          String          @id @db.Char(24)
  variantId   String          @db.Char(24)
  delta       Int
  reason      StockMoveReason
  reference   String?         @db.VarChar(191)
  note        String?         @db.Text
  createdById String?         @db.Char(24)
  createdAt   DateTime        @default(now())

  @@index([variantId, createdAt])
  @@map("stockmovements")
}

/* ============================== Commerce ============================== */

model Cart {
  id         String   @id @db.Char(24)
  userId     String?  @unique @db.Char(24)
  sessionKey String?  @unique @db.VarChar(191)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @db.Char(24)
  cartId    String   @db.Char(24)
  variantId String   @db.Char(24)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  cart Cart @relation(fields: [cartId], references: [id])

  @@index([cartId])
  @@index([variantId])
  @@map("cartitems")
}

model Coupon {
  id           String       @id @db.Char(24)
  code         String       @unique @db.VarChar(64)
  description  String?      @db.Text
  discountType DiscountType
  value        Decimal      @db.Decimal(12, 2)
  minSubtotal  Decimal?     @db.Decimal(12, 2)
  maxDiscount  Decimal?     @db.Decimal(12, 2)
  startsAt     DateTime?
  endsAt       DateTime?
  usageLimit   Int?
  perUserLimit Int?
  timesUsed    Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @db.Char(24)
  couponId  String   @db.Char(24)
  orderId   String   @db.Char(24)
  userId    String?  @db.Char(24)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@map("couponredemptions")
}

model Order {
  id                          String           @id @db.Char(24)
  orderNumber                 String           @unique @db.VarChar(32)
  userId                      String           @db.Char(24)
  status                      OrderStatus      @default(PENDING)
  paymentStatus               PaymentStatus    @default(PENDING)
  paymentMethod               PaymentMethod    @default(PAY_ON_CONFIRMATION)
  subtotal                    Decimal          @db.Decimal(12, 2)
  discountTotal               Decimal          @default(0) @db.Decimal(12, 2)
  shippingFee                 Decimal          @default(0) @db.Decimal(12, 2)
  grandTotal                  Decimal          @db.Decimal(12, 2)
  currency                    String           @default("INR") @db.VarChar(8)
  couponCode                  String?          @db.VarChar(64)
  pointsRedeemed              Int              @default(0)
  pointsEarned                Int              @default(0)
  idempotencyKey              String           @unique @db.VarChar(191)
  shipName                    String           @db.VarChar(191)
  shipPhone                   String           @db.VarChar(32)
  shipLine1                   String           @db.VarChar(191)
  shipLine2                   String?          @db.VarChar(191)
  shipCity                    String           @db.VarChar(191)
  shipState                   String           @db.VarChar(191)
  shipPincode                 String           @db.VarChar(16)
  shipCountry                 String           @default("India") @db.VarChar(191)
  cancelledReason             String?          @db.Text
  adminNote                   String?          @db.Text
  source                      OrderSource      @default(ONLINE)
  paymentIntentProvider       PaymentProvider?
  paymentIntentGatewayOrderId String?          @db.VarChar(191)
  paymentIntentCreatedAt      DateTime?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @default(now()) @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  items    OrderItem[]
  events   OrderEvent[]
  payment  OrderPayment?
  shipment OrderShipment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id          String   @id @db.Char(24)
  orderId     String   @db.Char(24)
  productId   String?  @db.Char(24)
  variantId   String?  @db.Char(24)
  productName String   @db.VarChar(191)
  variantName String   @db.VarChar(191)
  sku         String   @db.VarChar(191)
  imageUrl    String?  @db.VarChar(500)
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("orderitems")
}

model OrderEvent {
  id        String      @id @db.Char(24)
  orderId   String      @db.Char(24)
  status    OrderStatus
  note      String?     @db.Text
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("orderevents")
}

model OrderPayment {
  id          String        @id @db.Char(24)
  orderId     String        @unique @db.Char(24)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(12, 2)
  providerRef String?       @db.VarChar(191)
  verifiedAt  DateTime?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("orderpayments")
}

model OrderShipment {
  id             String         @id @db.Char(24)
  orderId        String         @unique @db.Char(24)
  carrier        String?        @db.VarChar(191)
  trackingNumber String?        @db.VarChar(191)
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@map("ordershipments")
}

model ShippingRate {
  id        String   @id @db.Char(24)
  name      String   @db.VarChar(191)
  baseFee   Decimal  @db.Decimal(12, 2)
  freeAbove Decimal? @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("shippingrates")
}

/* ============================= Engagement ============================= */

model Review {
  id                 String       @id @db.Char(24)
  productId          String       @db.Char(24)
  userId             String       @db.Char(24)
  authorName         String       @db.VarChar(191)
  rating             Int
  title              String       @default("") @db.VarChar(191)
  body               String       @db.Text
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(PENDING)
  createdAt          DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@map("reviews")
}

model NewsletterSubscriber {
  id             String    @id @db.Char(24)
  email          String    @unique @db.VarChar(191)
  source         String    @default("footer") @db.VarChar(64)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@map("newslettersubscribers")
}

model RestockAlert {
  id         String    @id @db.Char(24)
  productId  String    @db.Char(24)
  variantId  String?   @db.Char(24)
  email      String    @db.VarChar(191)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([productId, email])
  @@map("restockalerts")
}

model ReturnRequest {
  id          String       @id @db.Char(24)
  orderNumber String       @db.VarChar(32)
  userId      String       @db.Char(24)
  type        ReturnType
  reason      String       @db.Text
  details     String       @db.Text
  status      ReturnStatus @default(REQUESTED)
  adminNote   String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  user  User         @relation(fields: [userId], references: [id])
  items ReturnItem[]

  @@index([orderNumber])
  @@index([status, createdAt])
  @@map("returnrequests")
}

model ReturnItem {
  id              String  @id @db.Char(24)
  returnRequestId String  @db.Char(24)
  orderItemId     String? @db.VarChar(64)
  productName     String  @db.VarChar(191)
  variantName     String  @default("") @db.VarChar(191)
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id])

  @@index([returnRequestId])
  @@map("returnitems")
}

model ProductQuestion {
  id           String         @id @db.Char(24)
  productId    String         @db.Char(24)
  userId       String         @db.Char(24)
  authorName   String         @db.VarChar(191)
  question     String         @db.Text
  answer       String?        @db.Text
  answeredAt   DateTime?
  answeredById String?        @db.Char(24)
  status       QuestionStatus @default(PENDING)
  createdAt    DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@map("productquestions")
}

model LoyaltyLedger {
  id        String        @id @db.Char(24)
  userId    String        @db.Char(24)
  orderId   String?       @db.Char(24)
  delta     Int
  reason    LoyaltyReason
  note      String?       @db.Text
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([orderId, reason])
  @@map("loyaltyledger")
}

/* =============================== Misc =============================== */

model HomepageBanner {
  id        String   @id @db.Char(24)
  title     String   @db.VarChar(191)
  subtitle  String?  @db.Text
  imageUrl  String   @db.VarChar(500)
  ctaLabel  String?  @db.VarChar(191)
  ctaHref   String?  @db.VarChar(500)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("homepagebanners")
}

model SiteSetting {
  id        String   @id @db.Char(24)
  key       String   @unique @db.VarChar(191)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("sitesettings")
}

model ContactMessage {
  id        String        @id @db.Char(24)
  name      String        @db.VarChar(191)
  phone     String?       @db.VarChar(32)
  email     String?       @db.VarChar(191)
  subject   String        @db.VarChar(191)
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@map("contactmessages")
}

model AuditLog {
  id         String   @id @db.Char(24)
  actorId    String?  @db.Char(24)
  actorEmail String?  @db.VarChar(191)
  action     String   @db.VarChar(191)
  entityType String   @db.VarChar(64)
  entityId   String?  @db.VarChar(64)
  metadata   Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("auditlogs")
}

model WebhookEvent {
  id          String    @id @db.Char(24)
  provider    String    @db.VarChar(32)
  eventId     String    @unique @db.VarChar(191)
  payload     Json
  status      String    @default("RECEIVED") @db.VarChar(32)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("webhookevents")
}

model CashSession {
  id             String     @id @db.Char(24)
  terminalId     String     @db.VarChar(16)
  status         CashStatus @default(OPEN)
  openedById     String?    @db.Char(24)
  openedByName   String?    @db.VarChar(120)
  openingBalance Decimal    @default(0) @db.Decimal(12, 2)
  openingNote    String?    @db.VarChar(300)
  countedBalance Decimal?   @db.Decimal(12, 2)
  expectedCash   Decimal?   @db.Decimal(12, 2)
  cashSales      Decimal?   @db.Decimal(12, 2)
  variance       Decimal?   @db.Decimal(12, 2)
  closingNote    String?    @db.VarChar(300)
  openedAt       DateTime
  closedAt       DateTime?
  createdAt      DateTime   @default(now())

  @@index([terminalId, status])
  @@index([status])
  @@index([openedAt])
  @@map("cashsessions")
}

model ChatThread {
  id                 String     @id @db.Char(24)
  customerId         String?    @db.Char(24)
  guestKey           String?    @db.VarChar(64)
  displayName        String     @db.VarChar(120)
  contactHint        String?    @db.VarChar(191)
  lastMessagePreview String     @default("") @db.VarChar(140)
  lastMessageAt      DateTime   @default(now())
  unreadForAdmin     Int        @default(0)
  unreadForCustomer  Int        @default(0)
  status             ChatStatus @default(OPEN)
  closedAt           DateTime?
  closedByName       String?    @db.VarChar(120)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt

  messages ChatMessage[]

  @@index([customerId])
  @@index([guestKey])
  @@index([lastMessageAt])
  @@index([status, unreadForAdmin])
  @@map("chatthreads")
}

model ChatMessage {
  id          String   @id @db.Char(24)
  threadId    String   @db.Char(24)
  senderRole  ChatRole
  senderId    String?  @db.Char(24)
  senderName  String   @default("") @db.VarChar(120)
  body        String   @db.VarChar(2000)
  clientMsgId String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
  @@index([clientMsgId])
  @@map("chatmessages")
}

/* ============================== Enums ============================== */

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StockMoveReason {
  INITIAL
  PURCHASE
  ORDER_COMMIT
  ORDER_RELEASE
  MANUAL_ADJUST
}

enum DiscountType {
  PERCENT
  FIXED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PAY_ON_CONFIRMATION
  GATEWAY
}

enum PaymentProvider {
  razorpay
  stripe
  demo
}

enum OrderSource {
  ONLINE
  POS
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum QuestionStatus {
  PENDING
  ANSWERED
  HIDDEN
}

enum LoyaltyReason {
  EARN
  REDEEM
  REFUND_EARN
  REFUND_REDEEM
  ADJUST
}

enum ContactStatus {
  NEW
  HANDLED
}

enum CashStatus {
  OPEN
  CLOSED
}

enum ChatStatus {
  OPEN
  CLOSED
}

enum ChatRole {
  CUSTOMER
  ADMIN
}
